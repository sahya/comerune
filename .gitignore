# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# If you're building an application, you may want to check-in your pubspec.lock
pubspec.lock

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# Android generated files
android/local.properties
android/**/GeneratedPluginRegistrant.java

# Application ID (fork-protected — see android/app_id.properties.example)
android/app_id.properties

# OAuth BFF / OIDC build-time defines (fork-protected — see android/oauth_bff.env.example)
# Consumed by both `flutter build --dart-define-from-file=android/oauth_bff.env`
# and android/app/build.gradle.kts (reads OAUTH_BFF_HOST for the App Links host).
android/oauth_bff.env

# Android Developer Verification snippet (account-specific identifier from Play Console)
# Used as ANDROID_ADI_REGISTRATION_PUBLIC_CONTENT_FILE input for `make build-adi-verification`.
adi-registration.properties

# IDE files
.idea/
*.iml
.metadata

# Analysis options (auto-generated)
analysis_options.yaml

# VOICEVOX Core native library and assets - download from GitHub releases
# See docs/issues/voicevox/voicevox_core_0162_api.md for setup instructions
android/app/src/main/jniLibs/
android/app/src/main/assets/voicevox_models/*.vvm
android/app/src/main/assets/open_jtalk_dic_utf_8-1.11/

# Claude Code
.claude/
CLAUDE.local.md

# AI agent local rules (Codex / その他)
AGENTS.local.md

# ニコニコ生放送 連携ドキュメント (NDA相当・外部共有禁止)
# Git Submodule (private) として管理する想定 — 公開リポジトリには含めない
niconame-integration-docs/

# OpenAI Codex local project settings
.codex
.codex.project.toml
